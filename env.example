# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Dashboard do Supabase > Project Settings > API)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# NUNCA coloque a service_role key aqui — ela dá acesso total ao banco
# ignorando RLS e só pode ser usada em backend/Edge Functions.
